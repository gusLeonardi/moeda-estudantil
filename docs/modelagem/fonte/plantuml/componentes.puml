@startuml componentes
title Diagrama de Componentes — Conquista (arquitetura MVC)
skinparam shadowing false
skinparam component {
  BackgroundColor<<impl>> #e3f4ea
  BorderColor<<impl>> #2f855a
  BackgroundColor<<previsto>> White
  BorderColor<<previsto>> #52606d
  BorderStyle<<previsto>> dashed
}

package "Cliente — View (navegador)" {
  [Camada de serviços HTTP\n(Axios)] as AXIOS <<impl>>
  [Páginas e Formulários\n(React Hook Form + Zod)] as PAGS <<impl>>
  [React + TypeScript\n(Vite, Tailwind CSS, React Router)] as REACT <<impl>>
}

interface "API REST /api\n(HTTP/JSON)" as REST

package "Controller — FastAPI (Uvicorn)" {
  [Routers FastAPI] as ROUTERS <<impl>>
  [Schemas Pydantic] as SCHEMAS <<impl>>
  [Tratamento de erros / CORS] as ERROS <<impl>>
  [AuthRouter] as AUTHR <<previsto>>
  [ProfessorRouter] as PROFR <<previsto>>
  [Extrato/VantagemRouter] as EXTR <<previsto>>
}

package "Model — Services" {
  [AlunoService, EmpresaService,\nInstituicaoService] as SERVICES <<impl>>
  [AuthService] as AUTHS <<previsto>>
  [MoedaService / CupomService] as MOEDAS <<previsto>>
  [CreditoSemestralJob\n(APScheduler)] as JOB <<previsto>>
}

package "Model — Persistência" {
  [UsuarioRepository] as REPO <<impl>>
  [SQLAlchemy 2 (ORM)] as ORM <<impl>>
  [Alembic] as ALEMBIC <<impl>>
  [Outros Repositories] as REPOS2 <<previsto>>
}

package "Transversais" {
  [Configuração (pydantic-settings)] as CFG <<impl>>
  [Seed de instituições] as SEED <<impl>>
  [Segurança (OAuth2/JWT, bcrypt)] as SEC <<previsto>>
  [Serviço de e-mail (SMTP)] as MAIL <<previsto>>
  [Armazenamento de fotos] as FOTOS <<previsto>>
}

database "PostgreSQL (Neon)" as PG

REACT --> PAGS
PAGS --> AXIOS
AXIOS --( REST
REST - ROUTERS
ROUTERS --> SCHEMAS
ROUTERS --> SERVICES : usa
SERVICES --> REPO : usa
REPO --> ORM
ALEMBIC --> ORM : metadata
ORM --> PG : SQL (psycopg)
ALEMBIC --> PG : DDL
SEED --> ORM

legend bottom
  Verde: implementado na Sprint 2. Tracejado/branco: previsto (Sprint 3), não implementado.
endlegend
@enduml
