@startuml classes
title Diagrama de Classes — Conquista (modelo conceitual completo)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #52606d
  BackgroundColor White
}
skinparam class<<impl>> {
  BackgroundColor #e3f4ea
  BorderColor #2f855a
}
skinparam class<<parcial>> {
  BackgroundColor #fff4d6
  BorderColor #b7791f
}

enum Perfil <<parcial>> {
  ALUNO
  PROFESSOR
  EMPRESA
}

enum StatusCupom {
  EMITIDO
  UTILIZADO
}

abstract class Usuario <<parcial>> {
  - id: int
  - nome: str
  - email: str {unique}
  - login: str
  - senha_hash: str
  - perfil: Perfil
  + autenticar(senha): bool
}

class Endereco <<impl>> {
  - id: int
  - logradouro: str
  - numero: str
  - complemento: str
  - bairro: str
  - cidade: str
  - estado: str
  - cep: str
}

class InstituicaoEnsino <<impl>> {
  - id: int
  - nome: str {unique}
  - sigla: str {unique}
}

class Professor {
  - cpf: str
  - departamento: str
  - saldo: int
  + enviar_moedas(aluno, valor, motivo)
  + creditar_semestre(valor)
  + consultar_extrato(): list[Transacao]
}

class Aluno <<impl>> {
  - cpf: str {unique}
  - rg: str
  - curso: str
  - saldo: Decimal
  + receber_moedas(valor)
  + debitar(valor)
  + consultar_extrato(): list[Transacao]
}

class EmpresaParceira <<impl>> {
  - cnpj: str {unique}
  - telefone: str
  + cadastrar_vantagem(v)
  + conferir_cupom(codigo): bool
}

class Vantagem {
  - id: int
  - nome: str
  - descricao: str
  - foto_url: str
  - custo_moedas: int
  - ativa: bool
}

abstract class Transacao {
  - id: int
  - data: datetime
  - valor: int
  + descricao(): str
}

class TransacaoEnvio {
  - motivo: str
}

class TransacaoResgate {
  - codigo_cupom: str
  - status: StatusCupom
}

Usuario --> "1" Perfil : perfil
Usuario "1" *-- "1" Endereco : possui
Usuario <|-- Professor
Usuario <|-- Aluno
Usuario <|-- EmpresaParceira

Professor "*" --> "1" InstituicaoEnsino : pertence a
Aluno "*" --> "1" InstituicaoEnsino : estuda em
EmpresaParceira "1" o-- "*" Vantagem : oferece

Transacao <|-- TransacaoEnvio
Transacao <|-- TransacaoResgate
TransacaoEnvio "*" --> "1" Professor : remetente
TransacaoEnvio "*" --> "1" Aluno : destinatário
TransacaoResgate "*" --> "1" Aluno : realizado por
TransacaoResgate "*" --> "1" Vantagem : resgata
TransacaoResgate ..> StatusCupom

legend bottom
  Verde: implementada na Sprint 2. Amarelo: parcial. Branco: prevista (Sprint 3).
  Métodos são conceituais; na Sprint 2 as regras ficam nos Services.
endlegend
@enduml
