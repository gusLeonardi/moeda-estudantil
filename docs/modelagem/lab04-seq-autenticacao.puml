@startuml
title Autenticacao e ativacao de conta antiga
autonumber
actor Usuario
boundary "Frontend React" as UI
control "API FastAPI / Auth Router" as API
control "Rate limit + Auth Service" as Auth
database PostgreSQL as DB
participant "SMTP configurado" as SMTP

Usuario -> UI: Informa e-mail e senha
UI -> API: POST /auth/login
API -> Auth: Limita por IP/e-mail
Auth -> DB: Incrementa contadores atomicos
alt Limite excedido
  API --> UI: 429 + Retry-After
else Dentro do limite
  API -> Auth: authenticate(email, senha)
  Auth -> DB: Consulta usuario e hash
  DB --> Auth: Perfil + hash Argon2
  alt Conta ativa e senha valida
    Auth --> API: Usuario autenticado
    API --> UI: JWT HS256 (30 min) + id/nome/perfil
  else Credencial invalida ou conta sem senha
    API --> UI: 401 generico
  end
end

opt Ativacao de conta legada (sem senha)
  Usuario -> UI: Solicita envio do token
  UI -> API: POST /auth/activation/request (e-mail)
  API -> Auth: Limite por IP/e-mail; resposta nao enumeravel
  Auth -> DB: Localiza conta elegivel
  alt Conta elegivel
    Auth -> DB: Grava hash SHA-256 + expiracao de 15 min
    Auth -> SMTP: Envia token para e-mail cadastrado
    alt Falha na entrega
      Auth -> DB: Invalida grant pendente
    else Entregue
      SMTP --> Usuario: Token temporario no e-mail cadastrado
    end
  else Conta inexistente ou ja ativada
    Auth -> Auth: Nao cria grant; nao revela estado
  end
  API --> UI: 202 + mensagem generica
  Usuario -> UI: Envia e-mail, token e nova senha
  UI -> API: POST /auth/activation/complete
  API -> Auth: Confere token, senha e elegibilidade
  Auth -> DB: Consome token atomicamente e grava hash Argon2
  alt Token valido, dentro do prazo e nao usado
    DB --> Auth: Commit; token invalido para novo uso
    API --> UI: 204
  else Invalido, expirado, reutilizado ou conta ativa
    API --> UI: Erro generico; sem alteracao de credencial
  end
end
@enduml
