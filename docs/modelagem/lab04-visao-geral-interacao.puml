@startuml
title UML 2 Interaction Overview - Conquista
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #3155A6
  DiamondBackgroundColor #E0F2FE
  DiamondBorderColor #0369A1
}

start
:<<InteractionUse>> ref\nlab04-seq-autenticacao;
if (JWT valid and account active?) then (yes)
  if (Role PROFESSOR and transfer requested?) then (yes)
    :<<InteractionUse>> ref\nlab04-seq-transferencia;
  else (no)
    if (Role ALUNO and redemption requested?) then (yes)
      :<<InteractionUse>> ref\nlab04-seq-resgate;
    else (Role EMPRESA and coupon check requested)
      :<<InteractionUse>> ref\nlab04-seq-cupom;
    endif
  endif
else (no)
  :Return HTTP 401 or HTTP 403;
endif
stop

note right
  Each stereotyped action is an InteractionUse node
  referencing the named sequence interaction.
  Decision and merge control nodes follow UML Activity notation.
end note
@enduml
