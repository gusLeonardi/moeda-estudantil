%% Conquista — classes do fluxo de moedas
classDiagram
  Usuario <|-- Aluno
  Usuario <|-- Professor
  Usuario <|-- EmpresaParceira
  InstituicaoEnsino "1" --> "0..*" Aluno
  InstituicaoEnsino "1" --> "0..*" Professor
  Professor "1" --> "0..*" TransferenciaMoedas
  Aluno "1" --> "0..*" TransferenciaMoedas
  EmpresaParceira "1" --> "0..*" Vantagem
  Aluno "1" --> "0..*" ResgateVantagem
  Vantagem "1" --> "0..*" ResgateVantagem

  class Professor {
    +cpf: str
    +departamento: str
    +saldo: Decimal
  }
  class TransferenciaMoedas {
    +quantidade: Decimal
    +justificativa: str
    +criado_em: datetime
  }
  class Vantagem {
    +nome: str
    +descricao: str
    +custo: Decimal
    +ativa: bool
  }
  class ResgateVantagem {
    +custo: Decimal
    +codigo_cupom: str
    +idempotency_key: str
    +criado_em: datetime
  }
