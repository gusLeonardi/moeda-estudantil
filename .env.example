# PostgreSQL Neon (copie para .env e substitua os valores)
DATABASE_URL=postgresql+psycopg://usuario:senha@host/neondb?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Local development; set APP_ENV=production on the production backend
APP_ENV=development
JWT_SECRET=
ADMIN_CRON_TOKEN=
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD_HASH=

# Optional email delivery for account activation, redemptions and transfer notices
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
